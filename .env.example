# ---- server-side only (scripts/), never bundled into the frontend ----
# Private key used by scripts/deploy.mjs and scripts/seed.mjs.
DEPLOYER_PRIVATE_KEY=0x<64-hex-chars>

# Optional second key so `npm run seed` can play the replicator role
# (an author cannot replicate their own claim). Leave it empty and the seed
# script generates a fresh one and writes it back here.
REPLICATOR_PRIVATE_KEY=

# ---- client-side (VITE_ prefix = bundled and PUBLIC) ----
VITE_CONTRACT_ADDRESS=0x...
VITE_NETWORK=studionet
