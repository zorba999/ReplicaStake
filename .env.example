# =============================================================================
# LOCAL ONLY - never add these to Vercel or any other host.
# scripts/deploy.mjs and scripts/seed.mjs read them from a .env on your machine.
# They have no VITE_ prefix on purpose, so Vite cannot bundle them.
# =============================================================================

# Signs the contract deployment and the seed transactions.
DEPLOYER_PRIVATE_KEY=0x<64-hex-chars>

# Optional second key so `npm run seed` can play the replicator role (an author
# cannot replicate their own claim). Leave it empty and the seed script
# generates a fresh one and writes it back here.
REPLICATOR_PRIVATE_KEY=

# =============================================================================
# PUBLIC - the VITE_ prefix means this IS compiled into the browser bundle.
# This is the only variable the frontend needs, on Vercel or anywhere else.
# =============================================================================

VITE_CONTRACT_ADDRESS=0x5A847C2FE14eA9490D98887AF0aaDd369B6Bcfb2
